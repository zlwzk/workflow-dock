<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WorkflowDock</RootNamespace>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>

    <!-- 宿主的 plugins 目录：构建完成后插件会被自动拷贝到这里（已指向本机实际安装的 WinIsland） -->
    <WinIslandPluginsDir Condition="'$(WinIslandPluginsDir)' == ''">E:\Users\zlwzk\AppData\Local\Programs\WinIsland\plugins</WinIslandPluginsDir>

    <!-- 插件安装目录名 = 插件 id -->
    <PluginTargetDir>$(WinIslandPluginsDir)\workflow-dock</PluginTargetDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- 插件 SDK 从 NuGet 装（主次版本 = 宿主 API 版本，当前 2.4.0）。
         ExcludeAssets="runtime"：WinIsland.Core.dll 由宿主提供，不能进插件包 -->
    <PackageReference Include="luolan.winland.Core" Version="2.4.0" PrivateAssets="all" ExcludeAssets="runtime" />

    <!-- Windows App SDK / WinUI 运行时同样由宿主提供，排除出运行时 -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 构建后：把插件文件拷进宿主 plugins\<id>\ 目录（宿主的运行时文件不拷） -->
  <Target Name="CopyToWinIsland" AfterTargets="Build">
    <ItemGroup>
      <PluginArtifacts Include="$(OutDir)**\*.*" />
      <PluginArtifacts Remove="$(OutDir)WinIsland.Core.dll" />
      <PluginArtifacts Remove="$(OutDir)Microsoft.WinUI.dll" />
      <PluginArtifacts Remove="$(OutDir)Microsoft.Windows.SDK.NET.dll" />
      <PluginArtifacts Remove="$(OutDir)WinRT.Runtime.dll" />
      <PluginArtifacts Remove="$(OutDir)Microsoft.Windows.*.dll" />
      <PluginArtifacts Remove="$(OutDir)Microsoft.Web.WebView2*.dll" />
      <PluginArtifacts Remove="$(OutDir)WebView2Loader.dll" />
      <PluginArtifacts Remove="$(OutDir)Microsoft.Graphics.*.dll" />
      <PluginArtifacts Remove="$(OutDir)Microsoft.InteractiveExperiences.*.dll" />
      <PluginArtifacts Remove="$(OutDir)Microsoft.*.Projection.dll" />
      <PluginArtifacts Remove="$(OutDir)Microsoft.WindowsAppRuntime*" />
      <PluginArtifacts Remove="$(OutDir)**\*.pdb" />
    </ItemGroup>
    <MakeDir Directories="$(PluginTargetDir)" />
    <Copy
      SourceFiles="@(PluginArtifacts)"
      DestinationFiles="@(PluginArtifacts->'$(PluginTargetDir)\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
